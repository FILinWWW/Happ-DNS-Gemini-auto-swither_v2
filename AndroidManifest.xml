<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.pixel.happgemini">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Разрешаем видимость пакета Happ (com.happproxy) на Android 11-16 -->
    <queries>
        <package android:name="com.happproxy" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="happ" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Gemini &amp; Happ"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Кнопка Вкл/Выкл в верхней шторке быстрых настроек Google Pixel -->
        <service
            android:name=".HappQuickTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_lock_lock"
            android:label="Gemini + Happ"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
